{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://argosedgelab.local/schema/argos-direct-observation-request-v1.json",
  "title": "Argos direct read-only observation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision",
    "requestSchemaSha256",
    "resultSchemaSha256",
    "nonce",
    "expectedComputerName",
    "operation",
    "operationTimeoutSeconds",
    "maximumRows",
    "maximumFieldCharacters",
    "expectedScalar",
    "parameters",
    "authority"
  ],
  "properties": {
    "schema": {"const": "argos_direct_observation_request_v1"},
    "revision": {"type": "string", "pattern": "^[A-Z0-9_]{8,96}$"},
    "requestSchemaSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "resultSchemaSha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
    "nonce": {"type": "string", "pattern": "^[A-Z0-9_]{16,96}$"},
    "expectedComputerName": {"type": "string", "pattern": "^[A-Z0-9-]{1,32}$"},
    "operation": {"const": "WINDOWS_PROCESS_SNAPSHOT"},
    "operationTimeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 15},
    "maximumRows": {"type": "integer", "minimum": 1, "maximum": 16},
    "maximumFieldCharacters": {"type": "integer", "minimum": 64, "maximum": 4096},
    "expectedScalar": {"type": "string", "pattern": "^PASS_[A-Z0-9_]{8,120}$"},
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["processName", "exactExecutablePath", "commandLineContains"],
      "properties": {
        "processName": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,64}$"},
        "exactExecutablePath": {"type": "string", "minLength": 3, "maxLength": 260},
        "commandLineContains": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewOnly",
        "taskOrProcessManagementAllowed",
        "imageReadAllowed",
        "sourceMutationAllowed",
        "targetPersistentMutationAllowed",
        "providerActivationAllowed",
        "productionRoutingAllowed",
        "retryAuthorized",
        "maximumExecutions"
      ],
      "properties": {
        "reviewOnly": {"const": true},
        "taskOrProcessManagementAllowed": {"const": false},
        "imageReadAllowed": {"const": false},
        "sourceMutationAllowed": {"const": false},
        "targetPersistentMutationAllowed": {"const": false},
        "providerActivationAllowed": {"const": false},
        "productionRoutingAllowed": {"const": false},
        "retryAuthorized": {"const": false},
        "maximumExecutions": {"const": 1}
      }
    }
  }
}
