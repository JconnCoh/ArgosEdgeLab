{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "argos://schemas/opencv/scribe-job/v1",
  "title": "Argos OpenCV scribe job v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "jobId", "createdUtc", "identity", "inputs", "references", "search", "outputRoot", "authority"],
  "properties": {
    "schema": { "const": "argos_opencv_scribe_job_v1" },
    "revision": { "$ref": "#/definitions/id" },
    "jobId": { "$ref": "#/definitions/id" },
    "createdUtc": { "type": "string", "format": "date-time" },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["lotId", "acquisitionId", "slotId"],
      "properties": {
        "lotId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "acquisitionId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "slotId": { "type": "string", "pattern": "^Slot[0-9]{2}$" }
      }
    },
    "inputs": {
      "type": "object", "additionalProperties": false,
      "required": ["bf", "df"],
      "properties": {
        "bf": { "$ref": "#/definitions/source" },
        "df": { "$ref": "#/definitions/source" }
      }
    },
    "references": {
      "type": "object", "additionalProperties": false,
      "required": ["manifestPath", "manifestSha256", "roots"],
      "properties": {
        "manifestPath": { "$ref": "#/definitions/jbodPath" },
        "manifestSha256": { "$ref": "#/definitions/sha256" },
        "roots": {
          "type": "array", "minItems": 1, "maxItems": 8,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["relativePrefix", "path"],
            "properties": {
              "relativePrefix": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "maxLength": 80 },
              "path": { "$ref": "#/definitions/jbodPath" }
            }
          }
        }
      }
    },
    "search": {
      "type": "object", "additionalProperties": false,
      "required": ["expectedRegions", "boundedExceptionSearch", "maximumWorkingDimension", "maximumCandidates", "orientationStepDegrees"],
      "properties": {
        "expectedRegions": {
          "type": "array", "maxItems": 16,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["regionId", "x", "y", "width", "height", "angleDegrees", "source"],
            "properties": {
              "regionId": { "$ref": "#/definitions/id" },
              "x": { "type": "integer", "minimum": 0 },
              "y": { "type": "integer", "minimum": 0 },
              "width": { "type": "integer", "minimum": 1 },
              "height": { "type": "integer", "minimum": 1 },
              "angleDegrees": { "type": "number", "minimum": -180, "maximum": 180 },
              "source": { "enum": ["QUALIFIED_POSE_BOUND_PRIOR", "UNQUALIFIED_ARGOS_PRIOR_DIAGNOSTIC_ONLY", "OPERATOR_DESIGNATED_REVIEW_ONLY"] }
            }
          }
        },
        "boundedExceptionSearch": { "const": true },
        "maximumWorkingDimension": { "type": "integer", "minimum": 512, "maximum": 8192 },
        "maximumCandidates": { "type": "integer", "minimum": 1, "maximum": 128 },
        "orientationStepDegrees": { "type": "integer", "minimum": 5, "maximum": 45 }
      }
    },
    "outputRoot": { "$ref": "#/definitions/jbodPath" },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewOnly", "automaticIdentityAuthority", "trainingEligible", "xmlEligible", "productionEligible", "mayClearHolds"],
      "properties": {
        "reviewOnly": { "const": true },
        "automaticIdentityAuthority": { "const": false },
        "trainingEligible": { "const": false },
        "xmlEligible": { "const": false },
        "productionEligible": { "const": false },
        "mayClearHolds": { "const": false }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,119}$" },
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "jbodPath": { "type": "string", "pattern": "^[Dd]:[\\\\/]", "maxLength": 210 },
    "providerIoPath": { "type": "string", "pattern": "^[A-Z]:[\\\\/]", "maxLength": 190 },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "canonicalProvenancePath", "ioPathClass", "aliasName", "aliasAnchorCanonicalPath", "sha256", "bytes", "coordinateFrameId"],
      "properties": {
        "path": { "$ref": "#/definitions/providerIoPath" },
        "canonicalProvenancePath": { "$ref": "#/definitions/jbodPath" },
        "ioPathClass": { "const": "SHORT_DOS_DEVICE_ALIAS" },
        "aliasName": { "type": "string", "pattern": "^[A-Z]:$" },
        "aliasAnchorCanonicalPath": { "$ref": "#/definitions/jbodPath" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "bytes": { "type": "integer", "minimum": 1 },
        "coordinateFrameId": { "$ref": "#/definitions/id" }
      }
    }
  }
}
