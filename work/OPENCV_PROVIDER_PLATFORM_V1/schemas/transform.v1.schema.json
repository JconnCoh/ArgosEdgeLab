{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "argos://schemas/opencv/transform/v1",
  "title": "Argos OpenCV transform artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "revision", "jobId", "state", "qualified", "sourceFrameId", "targetFrameId", "transformType", "matrix3x3", "siteBinding", "residuals", "sourceBindings", "authority"],
  "properties": {
    "schema": { "const": "argos_opencv_transform_v1" },
    "revision": { "$ref": "#/definitions/id" },
    "jobId": { "$ref": "#/definitions/id" },
    "state": { "enum": ["PASS_QUALIFIED_TRANSFORM", "HOLD_NO_TRANSFORM", "HOLD_AMBIGUOUS_SITE", "HOLD_PROVENANCE_MISMATCH", "HOLD_SCHEMA_FIXTURE_ONLY"] },
    "qualified": { "type": "boolean" },
    "sourceFrameId": { "$ref": "#/definitions/id" },
    "targetFrameId": { "$ref": "#/definitions/id" },
    "transformType": { "enum": ["RIGID_2D", "AFFINE_2D", "HOMOGRAPHY_3X3"] },
    "matrix3x3": {
      "anyOf": [
        { "type": "array", "minItems": 9, "maxItems": 9, "items": { "type": "number" } },
        { "type": "null" }
      ]
    },
    "siteBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["siteBound", "predictionX", "predictionY", "eligibilityRadiusPixels", "refinedCandidateCount"],
      "properties": {
        "siteBound": { "type": "boolean" },
        "predictionX": { "type": ["number", "null"] },
        "predictionY": { "type": ["number", "null"] },
        "eligibilityRadiusPixels": { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "refinedCandidateCount": { "type": "integer", "minimum": 0 }
      }
    },
    "residuals": {
      "type": "object", "additionalProperties": false,
      "required": ["population", "count", "rmsPixels", "maximumPixels"],
      "properties": {
        "population": { "type": "string", "minLength": 1, "maxLength": 200 },
        "count": { "type": "integer", "minimum": 0 },
        "rmsPixels": { "type": ["number", "null"], "minimum": 0 },
        "maximumPixels": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "sourceBindings": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["role", "revision", "sha256"],
        "properties": {
          "role": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$" },
          "revision": { "$ref": "#/definitions/id" },
          "sha256": { "$ref": "#/definitions/sha256" }
        }
      }
    },
    "authority": { "$ref": "#/definitions/authority" }
  },
  "allOf": [
    {
      "if": { "properties": { "qualified": { "const": true } } },
      "then": {
        "properties": {
          "state": { "const": "PASS_QUALIFIED_TRANSFORM" },
          "matrix3x3": { "type": "array" },
          "siteBinding": {
            "properties": { "siteBound": { "const": true }, "refinedCandidateCount": { "const": 1 } }
          }
        }
      },
      "else": { "not": { "properties": { "state": { "const": "PASS_QUALIFIED_TRANSFORM" } } } }
    }
  ],
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{2,119}$" },
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinateEvidenceOnly", "productionEligible", "mayClearHolds"],
      "properties": {
        "coordinateEvidenceOnly": { "const": true },
        "productionEligible": { "const": false },
        "mayClearHolds": { "const": false }
      }
    }
  }
}
