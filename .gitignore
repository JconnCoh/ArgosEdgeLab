# This workspace contains large acquired-image, rendered-output, extracted-package,
# and terminal-evidence trees. Git is the source/checkpoint ledger, not the bulk
# evidence store. Start closed and admit the bounded continuity/source set below.
/*

!/.gitignore
!/README.md
!/AGENTS.md
!/ARGOS_WINDOWS_FAILURE_PREVENTION_MEMORY.md
!/*.md

!/utilities/
!/utilities/**

!/work/
/work/*
!/work/*.md
!/work/*.json

!/work/templates/
!/work/templates/**

!/work/FRONTSIDE_INSPECTION_REVIEW_ONLY/
/work/FRONTSIDE_INSPECTION_REVIEW_ONLY/*
!/work/FRONTSIDE_INSPECTION_REVIEW_ONLY/*.md
!/work/FRONTSIDE_INSPECTION_REVIEW_ONLY/*.json

# Exact current lot-recovery chain and unexecuted successor source.
!/work/R7/
!/work/R7/**
!/work/V40/
!/work/V40/**
!/work/R8/
!/work/R8/**
!/work/R9/
!/work/R9/**

# Bulk/generated artifacts remain local and file-backed outside Git.
*.zip
*.7z
*.tar
*.gz
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff
*.pdf
*.exe
*.dll
*.pdb
*.bin
*.db
*.db-journal
*.db-wal
*.log
*.stdout
*.stderr
*.tmp
*.bak
*.old
__pycache__/
*.pyc
.vs/
bin/
obj/
node_modules/
